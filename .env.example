VITE_SPOTIFY_CLIENT_ID=your_spotify_app_client_id
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Public LRCLIB-compatible base URL; no key is required by the default provider.
VITE_LYRICS_API_URL=https://lrclib.net/api
# Optional server-side provider configuration (never prefix secrets with VITE_).
# LYRICS_API_URL=https://your-provider.example/api
# LYRICS_API_KEY=
# Set false to use Spotify Web API only; lyrics still follow Spotify position.
VITE_SPOTIFY_SDK_ENABLED=true

# Server only; never use VITE_PEXELS_API_KEY.
PEXELS_API_KEY=
# Optional absolute folder; defaults to your local MusicWall application-data directory.
# MUSICWALL_VISUALS_DIR=
