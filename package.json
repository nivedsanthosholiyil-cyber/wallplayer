{
  "name": "musicwall",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Spontaneous cinematic music and synchronized lyrics wallpaper",
  "author": "Spontaneous",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:installer": "node scripts/test-installer.mjs",
    "start": "node scripts/serve.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "desktop": "npm run build:desktop && electron .",
    "desktop:run": "electron .",
    "package:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "package:win:dir": "npm run build:desktop && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/rubik-spray-paint": "^5.3.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.3"
  }
}
